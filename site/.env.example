# Copy to .env.local and fill in. Never commit .env.local.

# Google Analytics 4 measurement ID (optional; site works without it)
NEXT_PUBLIC_GA4_ID=

# Where lead form submissions are emailed
LEAD_TO_EMAIL=

# Resend API key for sending lead emails
RESEND_API_KEY=

# Sender shown on lead emails. Must be a verified domain in Resend, or leave unset to use onboarding@resend.dev for testing.
LEAD_FROM_EMAIL=
